// Abstract class
abstract class Employee {
    String name;
    int id;
    Employee(String name, int id) {
        this.name = name;
        this.id = id;
    }
    // Abstract method
    abstract double calculateBonus();
}
// Manager subclass
class Manager extends Employee {
    double salary;
    Manager(String name, int id, double salary) {
        super(name, id);
        this.salary = salary;
    }
    double calculateBonus() {
        return 0.20 * salary; // 20% bonus
    }
}
// Developer subclass
class Developer extends Employee {
    double salary;
    double incentive;
    Developer(String name, int id, double salary, double incentive) {
        super(name, id);
        this.salary = salary;
        this.incentive = incentive;
    }
    double calculateBonus() {
        return (0.10 * salary) + incentive; // 10% + incentive
    }
}
// Main class
public class Main {
    public static void main(String[] args) {
        // Runtime Polymorphism
        Employee e;
        e = new Manager("Alice", 101, 50000);
        System.out.println("Manager Bonus: " + e.calculateBonus());
        e = new Developer("Bob", 102, 40000, 5000);
        System.out.println("Developer Bonus: " + e.calculateBonus());
    }
}
//output:
Manager Bonus: 10000.0
Developer Bonus: 9000.0

